{
  "manifest_version": 3,
  "name": "Block Memento",
  "version": "1.0",
  "description": "Helps you remember why you blocked users on Twitter/X",
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://twitter.com/*",
    "https://x.com/*",
    "https://mobile.twitter.com/*",
    "https://mobile.x.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_width": 800,
    "default_height": 600,
    "default_icon": {
      "16": "images/icon16.png",
      "32": "images/icon32.png",
      "48": "images/icon48.png",
      "128": "images/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://twitter.com/*",
        "https://x.com/*",
        "https://mobile.twitter.com/*",
        "https://mobile.x.com/*"
      ],
      "js": ["content.js"]
    }
  ],
  "web_accessible_resources": [{
    "resources": ["images/icon48.png"],
    "matches": [
      "https://twitter.com/*",
      "https://x.com/*",
      "https://mobile.twitter.com/*",
      "https://mobile.x.com/*"
    ]
  }],
  "icons": {
    "16": "images/icon16.png",
    "32": "images/icon32.png",
    "48": "images/icon48.png",
    "128": "images/icon128.png"
  }
} 